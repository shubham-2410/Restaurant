{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@restaurant/shared": ["../../packages/shared/src/index.ts"],
      "@restaurant/shared/*": ["../../packages/shared/src/*"]
    }
  },
   "include": ["src", "../../packages/shared/src"],
  "exclude": ["node_modules", "dist"]
}